<Window x:Class="CRMRSDesktopApp.ProfileLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in" Width="392"
        SizeToContent="Height" MinHeight="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="White">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Name="lblTitle" Text="Sign in" FontSize="18" FontWeight="Bold"
                   Foreground="#FF0D0D0F" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Name="lblHint" TextWrapping="Wrap" FontSize="12"
                   Foreground="#FF6B6B74" Margin="0,0,0,18"
                   Text="Enter your mobile number to continue." />

        <StackPanel Grid.Row="2" Name="pnlMobile">
            <TextBlock Text="MOBILE NUMBER" FontSize="10" FontWeight="Bold"
                       Foreground="#FF9A9AA3" Margin="0,0,0,5" />
            <TextBox Name="txtMobile" Height="34" MaxLength="15" FontSize="14"
                     VerticalContentAlignment="Center" Padding="9,0"
                     BorderBrush="#FFE4E4E7" KeyDown="Field_KeyDown" />
        </StackPanel>

        <StackPanel Grid.Row="3" Name="pnlMethod" Visibility="Collapsed">
            <Border Background="#FFF7F7F8" BorderBrush="#FFE4E4E7" BorderThickness="1"
                    CornerRadius="8" Padding="12,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="MOBILE NUMBER" FontSize="9.5" FontWeight="Bold"
                                   Foreground="#FF9A9AA3" />
                        <TextBlock Name="lblMobileEcho" Text="--" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#FF0D0D0F" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Name="btnEditMobile" Content="Change" Height="26" Width="72"
                            VerticalAlignment="Center" Cursor="Hand" FontSize="12"
                            Background="White" BorderBrush="#FFE4E4E7"
                            Click="btnEditMobile_Click" />
                </Grid>
            </Border>

            <TextBlock Text="PROFILE PASSWORD" FontSize="10" FontWeight="Bold"
                       Foreground="#FF9A9AA3" Margin="0,16,0,5" />
            <PasswordBox Name="txtPass" Height="34" FontSize="14"
                         VerticalContentAlignment="Center" Padding="9,0"
                         BorderBrush="#FFE4E4E7" KeyDown="Field_KeyDown" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="1" Background="#FFE4E4E7" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="OR" FontSize="10" FontWeight="Bold"
                           Foreground="#FF9A9AA3" Margin="10,0" />
                <Border Grid.Column="2" Height="1" Background="#FFE4E4E7" VerticalAlignment="Center" />
            </Grid>

            <Button Name="btnFingerprint" Content="Sign in with fingerprint" Height="36"
                    Margin="0,14,0,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                    Background="White" Foreground="#FFCC3C00" BorderBrush="#FFFFD9C2"
                    BorderThickness="1" Click="btnFingerprint_Click" />
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FF9A9AA3" Margin="0,7,0,0"
                       Text="Scan a code with the CRMRS app on your phone and confirm with your fingerprint. No password needed." />
        </StackPanel>

        <TextBlock Grid.Row="4" Name="lblError" TextWrapping="Wrap" FontSize="12"
                   Foreground="#FFB3261E" Margin="0,14,0,0" Visibility="Collapsed" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Name="btnCancel" Content="Cancel" Width="88" Height="34" Margin="0,0,9,0"
                    Click="btnCancel_Click" />
            <Button Name="btnOk" Content="Continue" Width="104" Height="34" FontWeight="Bold"
                    Background="#FFFF5500" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="btnOk_Click" />
        </StackPanel>
    </Grid>
</Window>

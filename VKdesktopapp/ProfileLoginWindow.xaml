<Window x:Class="CRMRSDesktopApp.ProfileLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in" Height="330" Width="392"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="White">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Name="lblTitle" Text="Sign in" FontSize="18" FontWeight="Bold"
                   Foreground="#FF0D0D0F" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Name="lblHint" TextWrapping="Wrap" FontSize="12"
                   Foreground="#FF6B6B74" Margin="0,0,0,18"
                   Text="Enter your mobile number and your profile password." />

        <TextBlock Grid.Row="2" Text="MOBILE NUMBER" FontSize="10" FontWeight="Bold"
                   Foreground="#FF9A9AA3" Margin="0,0,0,5" />
        <TextBox Grid.Row="3" Name="txtMobile" Height="34" MaxLength="15" FontSize="14"
                 VerticalContentAlignment="Center" Padding="9,0" Margin="0,0,0,14"
                 BorderBrush="#FFE4E4E7" KeyDown="Field_KeyDown" />

        <StackPanel Grid.Row="4">
            <TextBlock Text="PROFILE PASSWORD" FontSize="10" FontWeight="Bold"
                       Foreground="#FF9A9AA3" Margin="0,0,0,5" />
            <PasswordBox Name="txtPass" Height="34" FontSize="14"
                         VerticalContentAlignment="Center" Padding="9,0"
                         BorderBrush="#FFE4E4E7" KeyDown="Field_KeyDown" />
            <TextBlock Name="lblError" TextWrapping="Wrap" FontSize="12" Foreground="#FFB3261E"
                       Margin="0,9,0,0" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Name="btnCancel" Content="Cancel" Width="88" Height="34" Margin="0,0,9,0"
                    Click="btnCancel_Click" />
            <Button Name="btnOk" Content="Sign in" Width="104" Height="34" FontWeight="Bold"
                    Background="#FFFF5500" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="btnOk_Click" />
        </StackPanel>
    </Grid>
</Window>

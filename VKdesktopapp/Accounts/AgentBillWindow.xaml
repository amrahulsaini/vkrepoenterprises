<Window x:Class="CRMRSDesktopApp.Accounts.AgentBillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate Agent Bill" Height="620" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="Fld" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Name="txtHead" Text="Generate Agent Bill"
                   FontSize="16" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,2" />
        <TextBlock DockPanel.Dock="Top" Name="txtSub" Text="" FontSize="12" Foreground="#888" Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Name="txtErr" Foreground="#C62828" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="200" />
            <Button Name="btnCancel" Content="Close" Width="90" Height="34" Margin="0,0,8,0" Click="btnCancel_Click" />
            <Button Name="btnGen" Content="Generate Bill" Width="140" Height="34" FontWeight="Bold"
                    Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="btnGen_Click" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#EEF3FB" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Name="txtCount" Text="Vehicles: 0" FontWeight="Bold" FontSize="13" />
                        <TextBlock Name="txtRepoTot" Text="Total Repo: 0" FontSize="12.5" />
                        <TextBlock Name="txtAdvTot" Text="Total Advance: 0" FontSize="12.5" />
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Invoice No" Style="{StaticResource Lbl}" />
                        <TextBox Name="txtInvoiceNo" Style="{StaticResource Fld}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Invoice Date" Style="{StaticResource Lbl}" />
                        <DatePicker Name="dpDate" Height="32" Margin="0,0,0,10" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Application Charges (universal for this agent)" Style="{StaticResource Lbl}" />
                <TextBox Name="txtAppCharges" Style="{StaticResource Fld}" />

                <TextBlock Text="Net Payable = Total Repo − Total Advance − Application Charges" FontSize="11" Foreground="#888" Margin="0,0,0,12" />

                <TextBlock Text="Letterhead (universal, optional)" Style="{StaticResource Lbl}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Image Name="imgLetter" Height="40" Width="120" Stretch="Uniform" Margin="0,0,10,0" />
                    <Button Content="Choose…" Height="30" Padding="12,0" Click="btnLetter_Click" />
                    <Button Content="Clear" Height="30" Padding="10,0" Margin="6,0,0,0" Click="btnLetterClear_Click" />
                </StackPanel>

                <TextBlock Text="Background (universal, optional)" Style="{StaticResource Lbl}" />
                <StackPanel Orientation="Horizontal">
                    <Image Name="imgBg" Height="40" Width="120" Stretch="Uniform" Margin="0,0,10,0" />
                    <Button Content="Choose…" Height="30" Padding="12,0" Click="btnBg_Click" />
                    <Button Content="Clear" Height="30" Padding="10,0" Margin="6,0,0,0" Click="btnBgClear_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

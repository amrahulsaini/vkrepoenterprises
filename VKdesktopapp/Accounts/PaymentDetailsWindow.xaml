<Window x:Class="CRMRSDesktopApp.Accounts.PaymentDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payment Details" Height="560" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="Fld" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Name="txtHead" Text="Payment Details"
                   FontSize="16" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" Name="txtSub" Text="" FontSize="12" Foreground="#888" Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Name="txtErr" Foreground="#C62828" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Name="btnCancel" Content="Cancel" Width="90" Height="34" Margin="0,0,8,0" Click="btnCancel_Click" />
            <Button Name="btnSave" Content="Save" Width="110" Height="34" FontWeight="Bold"
                    Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="btnSave_Click" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="UTR No" Style="{StaticResource Lbl}" />
                <TextBox Name="txtUtr" Style="{StaticResource Fld}" />

                <TextBlock Text="Bank Name" Style="{StaticResource Lbl}" />
                <TextBox Name="txtBank" Style="{StaticResource Fld}" />

                <TextBlock Text="Account Holder Name" Style="{StaticResource Lbl}" />
                <TextBox Name="txtHolder" Style="{StaticResource Fld}" />

                <TextBlock Text="Bank Account Number" Style="{StaticResource Lbl}" />
                <TextBox Name="txtAccountNo" Style="{StaticResource Fld}" />

                <TextBlock Text="IFSC Code" Style="{StaticResource Lbl}" />
                <TextBox Name="txtIfsc" Style="{StaticResource Fld}" />

                <TextBlock Text="Date of Payment" Style="{StaticResource Lbl}" />
                <DatePicker Name="dpDate" Height="32" Margin="0,0,0,10" />

                <TextBlock Text="Application Charges" Style="{StaticResource Lbl}" />
                <TextBox Name="txtAppCharges" Style="{StaticResource Fld}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

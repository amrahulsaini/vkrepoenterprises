<Page x:Class="CRMRSDesktopApp.Accounts.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F5">

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,14,0">
            <TextBlock DockPanel.Dock="Top" Text="Accounts" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource Accent}" Margin="0,0,0,8" />

            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="#666" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Margin" Value="0,0,6,0" />
                    </Style>
                    <Style TargetType="DatePicker">
                        <Setter Property="Height" Value="28" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Height" Value="28" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                    <Style TargetType="Button">
                        <Setter Property="Height" Value="28" />
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Height" Value="28" />
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>
                </StackPanel.Resources>

                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                    <TextBlock Text="From" />
                    <DatePicker Name="dpFrom" Width="120" SelectedDateChanged="Reload_Changed" />
                    <TextBlock Text="To" Margin="12,0,6,0" />
                    <DatePicker Name="dpTo" Width="120" SelectedDateChanged="Reload_Changed" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                    <TextBlock Text="Status" />
                    <ToggleButton Name="btnStatuses" Width="170" Content="All statuses"
                                  HorizontalContentAlignment="Left" Padding="8,0"
                                  ToolTip="Tick one or more statuses to show only those records" />
                    <Popup Name="popStatuses" PlacementTarget="{Binding ElementName=btnStatuses}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True"
                           IsOpen="{Binding IsChecked, ElementName=btnStatuses, Mode=TwoWay}">
                        <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8">
                            <StackPanel Width="230">
                                <ItemsControl Name="lstStatusPicks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Margin="2,3" Click="StatusPick_Changed">
                                                <TextBlock Text="{Binding Name}" Foreground="#222222" FontSize="12.5" Margin="0" />
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Clear selection" Height="26" Margin="0,6,0,0"
                                        Cursor="Hand" Click="btnClearStatus_Click" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Name="btnClearStatusTop" Content="&#10005;" Width="28" Margin="4,0,0,0"
                            ToolTip="Clear status filter" Click="btnClearStatus_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                    <TextBlock Text="Finance" />
                    <ComboBox Name="cmbFinance" Width="190" IsEditable="True" IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True"
                              SelectionChanged="Finance_Changed" KeyUp="Finance_Key"
                              ToolTip="Type to search a finance / head office, or pick from the list" />
                    <Button Name="btnClearFinance" Content="&#10005;" Width="28" Margin="4,0,0,0"
                            ToolTip="Clear finance filter" Click="btnClearFinance_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                    <TextBlock Text="Agent" />
                    <ToggleButton Name="btnAgents" Width="190" Content="All agents"
                                  HorizontalContentAlignment="Left" Padding="8,0"
                                  ToolTip="Tick one or more agents to show only their records" />
                    <Popup Name="popAgents" PlacementTarget="{Binding ElementName=btnAgents}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True"
                           IsOpen="{Binding IsChecked, ElementName=btnAgents, Mode=TwoWay}">
                        <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8">
                            <StackPanel Width="380">
                                <TextBox Name="txtAgentSearch" Height="26" Margin="0,0,0,6"
                                         VerticalContentAlignment="Center" Padding="6,0"
                                         ToolTip="Type to narrow the list, then press Enter to apply"
                                         TextChanged="AgentSearch_Changed" KeyDown="AgentPicker_KeyDown" />
                                <ListBox Name="lstAgentPicks" MaxHeight="340" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Margin="2" Click="AgentPick_Changed">
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="#222222" FontSize="12.5" Margin="0" />
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Clear selection" Height="26" Padding="10,0" Margin="0,0,6,0"
                                            Cursor="Hand" Click="btnClearAgent_Click" />
                                    <Button Content="Apply" Height="26" Padding="16,0" Cursor="Hand"
                                            Background="#1565C0" Foreground="White" BorderThickness="0"
                                            Click="btnApplyAgents_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Name="btnClearAgent" Content="&#10005;" Width="28" Margin="4,0,0,0"
                            ToolTip="Clear agent filter" Click="btnClearAgent_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                    <TextBlock Text="Inventory" />
                    <ComboBox Name="cmbInventory" Width="90" SelectedIndex="0"
                              SelectionChanged="Inventory_Changed"
                              ToolTip="Show only records marked Yes or No for inventory">
                        <ComboBoxItem Content="All" />
                        <ComboBoxItem Content="Yes" />
                        <ComboBoxItem Content="No" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                    <TextBlock Text="RC last 4" />
                    <TextBox Name="txtRcLast4" Width="90" Height="28" MaxLength="6"
                             VerticalContentAlignment="Center" TextAlignment="Center" FontWeight="Bold"
                             ToolTip="Type the last 4 digits of the RC or chassis"
                             TextChanged="RcLast4_Changed" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Name="btnRefresh" Content="&#8635; Refresh" Width="100" FontWeight="Bold"
                            Background="#1565C0" Foreground="White" BorderThickness="0"
                            ToolTip="Reload records from the server" Click="btnRefresh_Click" />
                    <TextBlock Name="txtStatus" Foreground="#888" Margin="14,0,0,0" />
                </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <DataGrid Name="grid" Style="{StaticResource XlGrid}"
                      CanUserSortColumns="True" FrozenColumnCount="2"
                      RowDetailsVisibilityMode="Collapsed"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      ClipboardCopyMode="IncludeHeader"
                      PreviewMouseLeftButtonDown="Grid_CellClick"
                      PreviewKeyDown="Grid_PreviewKeyDown"
                      PreviewMouseRightButtonDown="Grid_PreviewRightClick"
                      CellEditEnding="grid_CellEditEnding"
                      SelectionChanged="grid_SelectionChanged">
                <DataGrid.Resources>
                    <Style x:Key="PickEdit" TargetType="ComboBox">
                        <Setter Property="IsDropDownOpen" Value="True" />
                        <EventSetter Event="SelectionChanged" Handler="Pick_Changed" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy cell"                    Click="CopyCell_Click" />
                        <MenuItem Header="Copy selected rows"           Click="CopySelection_Click"    InputGestureText="Ctrl+C" />
                        <MenuItem Header="Copy selected rows + headers" Click="CopySelectionHdr_Click" InputGestureText="Ctrl+Shift+C" />
                        <Separator />
                        <MenuItem Header="Copy this column"             Click="CopyColumn_Click" />
                        <Separator />
                        <MenuItem Header="Copy whole table"             Click="CopyTable_Click" />
                        <Separator />
                        <MenuItem Header="Open full record..."          Click="OpenRecord_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Vehicle No" Binding="{Binding VehicleNo, UpdateSourceTrigger=Explicit}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName, UpdateSourceTrigger=Explicit}" Width="140" IsReadOnly="False" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Repo Date" Binding="{Binding RepoDate, UpdateSourceTrigger=Explicit}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Model" Binding="{Binding Model, UpdateSourceTrigger=Explicit}" Width="140" IsReadOnly="False" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Finance" Binding="{Binding FinanceName, UpdateSourceTrigger=Explicit}" Width="130" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Yard Name" Binding="{Binding ParkingYardName, UpdateSourceTrigger=Explicit}" Width="150" ElementStyle="{StaticResource XlText}" />
                    <DataGridComboBoxColumn x:Name="colInventory" Header="Inventory" SortMemberPath="CourierYn"
                                            SelectedItemBinding="{Binding CourierYn, UpdateSourceTrigger=PropertyChanged}"
                                            EditingElementStyle="{StaticResource PickEdit}" Width="85" />
                    <DataGridTextColumn Header="Inventory Remark" Binding="{Binding InventoryRemark, UpdateSourceTrigger=Explicit}" Width="170" ElementStyle="{StaticResource XlText}" />
                    <DataGridComboBoxColumn x:Name="colBilling" Header="Billing Status" SortMemberPath="ActionText"
                                            SelectedValueBinding="{Binding ActionKey, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Key" DisplayMemberPath="Name"
                                            EditingElementStyle="{StaticResource PickEdit}" Width="140" />
                    <DataGridTextColumn Header="Billing Remark" Binding="{Binding BillingRemark, UpdateSourceTrigger=Explicit}" Width="170" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Collection Update" Binding="{Binding CollectionUpdate, UpdateSourceTrigger=Explicit}" Width="150" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Addln Amount" Binding="{Binding AddlAmountText, UpdateSourceTrigger=Explicit}" Width="140" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Repo Charges" Binding="{Binding RepoChargesText, UpdateSourceTrigger=Explicit}" Width="140" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Gross Amount" Binding="{Binding GrossText, UpdateSourceTrigger=Explicit}" Width="140" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Remark" Binding="{Binding Remark, UpdateSourceTrigger=Explicit}" Width="140" IsReadOnly="False" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Cash Collected" Binding="{Binding CashText, UpdateSourceTrigger=Explicit}" Width="140" IsReadOnly="False" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Advance" Binding="{Binding AdvanceText, UpdateSourceTrigger=Explicit}" Width="140" IsReadOnly="False" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Seizing Charges" Binding="{Binding FinalText, UpdateSourceTrigger=Explicit}" Width="140" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="14">
            <Border.Resources>
                <Style x:Key="PFld" TargetType="TextBox">
                    <Setter Property="Height" Value="28" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="6,0" />
                    <Setter Property="Margin" Value="0,0,0,7" />
                </Style>
                <Style x:Key="PLbl" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#666" />
                    <Setter Property="FontSize" Value="11.5" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                </Style>
            </Border.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Payment / Bank Details" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock Name="txtPaySel" Text="Click a vehicle row to enter its payment details."
                               FontSize="11.5" Foreground="#888" TextWrapping="Wrap" Margin="0,2,0,8" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="pnlPay" IsEnabled="False" PreviewKeyDown="Panel_KeyDown">
                        <Border Background="#EEF3FB" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Name="txtChargesHead" Text="CHARGES" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource Accent}" Margin="0,0,0,8" />

                                <TextBlock Name="lblGross" Text="Gross Amount" Style="{StaticResource PLbl}" />
                                <TextBox Name="txtAcGross" Style="{StaticResource PFld}" IsReadOnly="True" Background="#E8EAED" />

                                <TextBlock Name="lblAcAddl" Text="Addln Amount (from billing)" Style="{StaticResource PLbl}" />
                                <TextBox Name="txtAcAddl" Style="{StaticResource PFld}" IsReadOnly="True" Background="#E8EAED" />

                                <TextBlock Name="lblAcPercent" Text="Percentage (%) of invoice amount" Style="{StaticResource PLbl}" />
                                <TextBox Name="txtAcPercent" Style="{StaticResource PFld}" TextChanged="AcCalc_Changed" />

                                <TextBlock Text="Repo Charges" Style="{StaticResource PLbl}" />
                                <TextBox Name="txtAcRepo" IsReadOnly="True" Style="{StaticResource PFld}" TextChanged="AcCalc_Changed" />

                                <TextBlock Text="Advance" Style="{StaticResource PLbl}" />
                                <TextBox Name="txtAcAdvance" Style="{StaticResource PFld}" TextChanged="AcCalc_Changed" />

                                <TextBlock Name="lblAcCash" Text="Cash Collected" Style="{StaticResource PLbl}" />
                                <TextBox Name="txtAcCash" Style="{StaticResource PFld}" TextChanged="AcCalc_Changed"
                                         Background="#FFF6E5" Foreground="#B26A00" FontWeight="Bold" />

                                <TextBlock Name="txtAcFinal" FontSize="12" FontWeight="Bold"
                                           Foreground="#1565C0" Margin="0,0,0,8" />

                                <TextBlock Name="lblAcShot" Text="Payment Screenshot" Style="{StaticResource PLbl}" Visibility="Collapsed" />
                                <Border Name="pnlAcShot" Visibility="Collapsed" BorderBrush="#E0E0E0" BorderThickness="1"
                                        CornerRadius="6" Padding="4" Margin="0,0,0,8">
                                    <Image Name="imgAcShot" MaxHeight="150" Stretch="Uniform" Cursor="Hand"
                                           MouseLeftButtonUp="imgAcShot_Click" />
                                </Border>

                                <Button Name="btnSaveCharges" Content="Save Charges" Height="32" FontWeight="Bold"
                                        Background="#1565C0" Foreground="White" BorderThickness="0"
                                        Cursor="Hand" Click="btnSaveCharges_Click" />
                                <TextBlock Name="txtChargesMsg" FontSize="11.5" Foreground="#2E7D32"
                                           Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Agent Name" Style="{StaticResource PLbl}" />
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Name="cmbEditAgent" Height="28" IsEditable="True"
                                      IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                      VerticalContentAlignment="Center" IsEnabled="False"
                                      ToolTip="Pick the agent from the list, or type a correction" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                                <Button Name="btnAgentEdit" Content="&#x270E;" Width="28" Height="28" FontSize="14"
                                        Cursor="Hand" ToolTip="Edit the agent name" Click="btnAgentEdit_Click" />
                                <Button Name="btnAgentSave" Content="&#x2714;" Width="28" Height="28" FontSize="12"
                                        Background="#2E7D32" Foreground="White" BorderThickness="0"
                                        Cursor="Hand" Visibility="Collapsed"
                                        ToolTip="Save the agent name" Click="btnAgentSave_Click" />
                                <Button Name="btnAgentCancel" Content="&#x2715;" Width="28" Height="28" FontSize="12"
                                        Margin="4,0,0,0" Cursor="Hand" Visibility="Collapsed"
                                        ToolTip="Cancel" Click="btnAgentCancel_Click" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Accounts Remark" Style="{StaticResource PLbl}" />
                        <TextBox Name="txtAcRemark" Height="52" Margin="0,0,0,7" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" Padding="8,4" />
                        <TextBlock Text="UTR No" Style="{StaticResource PLbl}" />
                        <TextBox Name="txtUtr" Style="{StaticResource PFld}" />
                        <TextBlock Text="Date of Payment" Style="{StaticResource PLbl}" />
                        <DatePicker Name="dpPayDate" Height="28" Margin="0,0,0,7" />
                        <TextBlock Text="Payment Status *" Style="{StaticResource PLbl}" />
                        <ComboBox Name="cmbPayStatus" SelectionChanged="PaymentStatus_Changed" Height="28" Margin="0,0,0,7" SelectedIndex="0">
                            <ComboBoxItem Content="-- select --" />
                            <ComboBoxItem Content="Paid" />
                            <ComboBoxItem Content="Unpaid" />
                        </ComboBox>
                        <Button Name="btnSavePay" Content="Save Payment Details" Height="32" FontWeight="Bold"
                                Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="btnSavePay_Click" Margin="0,2,0,0" />
                        <TextBlock Name="txtPayMsg" FontSize="11.5" Foreground="#2E7D32" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Bank details &amp; application charges are set on the agent bill (collective)."
                                   FontSize="11" Foreground="#999" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#EAF4EA" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Name="txtGrandVehicles" Text="Vehicles: 0" FontWeight="Bold" FontSize="13" />
                        <TextBlock Name="txtGrandRepo" Text="Total Repo: 0" FontSize="12.5" Foreground="#2E7D32" />
                        <TextBlock Name="txtGrandCash" Text="Total Cash Collected: 0" FontSize="12.5" Foreground="#B26A00" />
                        <TextBlock Name="txtGrandFinal" Text="Total Final: 0" FontSize="12.5" Foreground="#1565C0" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Button Grid.Row="3" Name="btnAgentBill" Content="Generate Agent Bill"
                        Height="38" FontWeight="Bold" Margin="0,10,0,0" Cursor="Hand"
                        Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                        Click="btnAgentBill_Click"
                        ToolTip="Click a vehicle row to pick its agent, then generate a combined bill for all that agent's vehicles in the selected dates" />
            </Grid>
        </Border>
    </Grid>
</Page>

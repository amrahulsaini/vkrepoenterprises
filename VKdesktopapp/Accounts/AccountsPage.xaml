<Page x:Class="CRMRSDesktopApp.Accounts.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F5">

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,14,0">
            <TextBlock DockPanel.Dock="Top" Text="Accounts" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource Accent}" Margin="0,0,0,8" />

            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="From" VerticalAlignment="Center" Foreground="#666" Margin="0,0,6,0" />
                <DatePicker Name="dpFrom" Width="130" Margin="0,0,14,0" SelectedDateChanged="Reload_Changed" />
                <TextBlock Text="To" VerticalAlignment="Center" Foreground="#666" Margin="0,0,6,0" />
                <DatePicker Name="dpTo" Width="130" Margin="0,0,14,0" SelectedDateChanged="Reload_Changed" />
                <TextBlock Text="Status" VerticalAlignment="Center" Foreground="#666" Margin="0,0,6,0" />
                <ComboBox Name="cmbAction" Width="150" Margin="0,0,14,0" SelectedIndex="0" SelectionChanged="Reload_Changed">
                    <ComboBoxItem Content="All" />
                    <ComboBoxItem Content="OK for billing" />
                    <ComboBoxItem Content="Hold for collection" />
                    <ComboBoxItem Content="Collection done" />
                    <ComboBoxItem Content="Billing Done" />
                </ComboBox>
                <TextBlock Text="Agent" VerticalAlignment="Center" Foreground="#666" Margin="0,0,6,0" />
                <ComboBox Name="cmbAgent" Width="220" Height="26" IsEditable="True" IsTextSearchEnabled="True"
                          StaysOpenOnEdit="True" VerticalContentAlignment="Center"
                          SelectionChanged="Agent_Changed" KeyUp="Agent_Key"
                          ToolTip="Type to search an agent, or pick from the list, then Generate Agent Bill" />
                <Button Name="btnClearAgent" Content="✕" Width="26" Height="26" Margin="4,0,0,0"
                        Cursor="Hand" ToolTip="Clear agent filter" Click="btnClearAgent_Click" />
                <TextBlock Text="RC last 4" VerticalAlignment="Center" Foreground="#666" Margin="0,0,6,0" />
                <TextBox Name="txtRcLast4" Width="90" Height="26" MaxLength="6" Margin="0,0,14,0"
                         VerticalContentAlignment="Center" TextAlignment="Center" FontWeight="Bold"
                         ToolTip="Type the last 4 digits of the RC or chassis"
                         TextChanged="RcLast4_Changed" />
                <Button Name="btnRefresh" Content="↻ Refresh" Width="100" Height="26" Margin="14,0,0,0" FontWeight="Bold"
                        Background="#1565C0" Foreground="White" BorderThickness="0" Cursor="Hand"
                        ToolTip="Reload records from the server" Click="btnRefresh_Click" />
                <TextBlock Name="txtStatus" VerticalAlignment="Center" Foreground="#888" FontSize="12" Margin="14,0,0,0" />
            </WrapPanel>

            <DataGrid Name="grid" Style="{StaticResource XlGrid}"
                      CanUserSortColumns="True" FrozenColumnCount="2"
                      RowDetailsVisibilityMode="VisibleWhenSelected"
                      PreviewMouseLeftButtonDown="XlGrid_RowClick"
                      CellEditEnding="grid_CellEditEnding"
                      SelectionChanged="grid_SelectionChanged">
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="#FFFBF4" BorderBrush="#EF6C00" BorderThickness="3,0,0,1" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="FULL RECORD" FontSize="10.5" FontWeight="Bold"
                                           Foreground="#EF6C00" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <StackPanel><TextBlock Text="Vehicle No" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding VehicleNo}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Chassis No" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding ChassisNo}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Customer" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding CustomerName}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Loan No" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding LoanNo}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Model" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding Model}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Finance" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding FinanceName}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Branch" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding BranchName}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Agent" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding AgentName}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Parking Yard" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding ParkingYardName}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Status" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding ActionText}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Repo Date" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding RepoDate}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Cash Collected" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding CashText}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="UTR No" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding UtrNo}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Payment Date" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding PaymentDate}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                </WrapPanel>
                                <TextBlock Text="Collection Update" Style="{StaticResource XlDetailLabel}" />
                                <TextBlock Text="{Binding CollectionUpdate}" Style="{StaticResource XlDetailValue}" />
                                <TextBlock Text="Remark" Style="{StaticResource XlDetailLabel}" />
                                <TextBlock Text="{Binding Remark}" Style="{StaticResource XlDetailValue}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Repo Date" Binding="{Binding RepoDate}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Agent" Binding="{Binding AgentName}" Width="140" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Vehicle No" Binding="{Binding VehicleNo}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="150" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Finance" Binding="{Binding FinanceName}" Width="130" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Branch" Binding="{Binding BranchName}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Status" Binding="{Binding ActionText}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Gross" Binding="{Binding GrossText}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="%" Binding="{Binding PercentText}" Width="60" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Repo Charges" Binding="{Binding RepoChargesText, UpdateSourceTrigger=PropertyChanged}" Width="110" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Advance" Binding="{Binding AdvanceText, UpdateSourceTrigger=PropertyChanged}" Width="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Cash Collected" Binding="{Binding CashText}" Width="110" IsReadOnly="True"
                                        ElementStyle="{StaticResource XlCashCell}" />
                    <DataGridTextColumn Header="Final" Binding="{Binding FinalText}" Width="100" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource XlMoney}">
                                <Setter Property="FontWeight" Value="Bold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Payment" Binding="{Binding PaymentStatusText}" Width="90" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource XlText}">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="PAID">
                                        <Setter Property="Foreground" Value="#1B7F3B" />
                                    </Trigger>
                                    <Trigger Property="Text" Value="UNPAID">
                                        <Setter Property="Foreground" Value="#C62828" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Screenshot" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="View" Padding="8,2" Margin="4" Cursor="Hand"
                                        Visibility="{Binding HasScreenshot}"
                                        Tag="{Binding}" Click="ViewScreenshot_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="14">
            <Border.Resources>
                <Style x:Key="PFld" TargetType="TextBox">
                    <Setter Property="Height" Value="28" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="6,0" />
                    <Setter Property="Margin" Value="0,0,0,7" />
                </Style>
                <Style x:Key="PLbl" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#666" />
                    <Setter Property="FontSize" Value="11.5" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                </Style>
            </Border.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Payment / Bank Details" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock Name="txtPaySel" Text="Click a vehicle row to enter its payment details."
                               FontSize="11.5" Foreground="#888" TextWrapping="Wrap" Margin="0,2,0,8" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="pnlPay" IsEnabled="False">
                        <Border Background="#EEF3FB" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Name="txtChargesHead" Text="CHARGES" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource Accent}" Margin="0,0,0,8" />

                                <TextBlock Name="lblGross" Text="Invoice Amount" Style="{StaticResource PLbl}" />
                                <TextBox Name="txtAcGross" Style="{StaticResource PFld}" IsReadOnly="True" Background="#E8EAED" />

                                <TextBlock Name="lblAcAddl" Text="Additional Charges (from app)" Style="{StaticResource PLbl}" />
                                <TextBox Name="txtAcAddl" Style="{StaticResource PFld}" IsReadOnly="True" Background="#E8EAED" />

                                <TextBlock Name="lblAcPercent" Text="Percentage (%) of invoice amount" Style="{StaticResource PLbl}" />
                                <TextBox Name="txtAcPercent" Style="{StaticResource PFld}" TextChanged="AcCalc_Changed" />

                                <TextBlock Text="Repo Charges" Style="{StaticResource PLbl}" />
                                <TextBox Name="txtAcRepo" Style="{StaticResource PFld}" TextChanged="AcCalc_Changed" />

                                <TextBlock Text="Advance" Style="{StaticResource PLbl}" />
                                <TextBox Name="txtAcAdvance" Style="{StaticResource PFld}" TextChanged="AcCalc_Changed" />

                                <TextBlock Name="lblAcCash" Text="Cash Collected (from app)" Style="{StaticResource PLbl}" />
                                <TextBox Name="txtAcCash" Style="{StaticResource PFld}" IsReadOnly="True"
                                         Background="#FFF6E5" Foreground="#B26A00" FontWeight="Bold" />

                                <TextBlock Name="txtAcFinal" FontSize="12" FontWeight="Bold"
                                           Foreground="#1565C0" Margin="0,0,0,8" />

                                <TextBlock Name="lblAcShot" Text="Payment Screenshot" Style="{StaticResource PLbl}" Visibility="Collapsed" />
                                <Border Name="pnlAcShot" Visibility="Collapsed" BorderBrush="#E0E0E0" BorderThickness="1"
                                        CornerRadius="6" Padding="4" Margin="0,0,0,8">
                                    <Image Name="imgAcShot" MaxHeight="150" Stretch="Uniform" Cursor="Hand"
                                           MouseLeftButtonUp="imgAcShot_Click" />
                                </Border>

                                <Button Name="btnSaveCharges" Content="Save Charges" Height="32" FontWeight="Bold"
                                        Background="#1565C0" Foreground="White" BorderThickness="0"
                                        Cursor="Hand" Click="btnSaveCharges_Click" />
                                <TextBlock Name="txtChargesMsg" FontSize="11.5" Foreground="#2E7D32"
                                           Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="UTR No" Style="{StaticResource PLbl}" />
                        <TextBox Name="txtUtr" Style="{StaticResource PFld}" />
                        <TextBlock Text="Date of Payment" Style="{StaticResource PLbl}" />
                        <DatePicker Name="dpPayDate" Height="28" Margin="0,0,0,7" />
                        <TextBlock Text="Payment Status *" Style="{StaticResource PLbl}" />
                        <ComboBox Name="cmbPayStatus" Height="28" Margin="0,0,0,7" SelectedIndex="0">
                            <ComboBoxItem Content="-- select --" />
                            <ComboBoxItem Content="Paid" />
                            <ComboBoxItem Content="Unpaid" />
                        </ComboBox>
                        <Button Name="btnSavePay" Content="Save Payment Details" Height="32" FontWeight="Bold"
                                Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="btnSavePay_Click" Margin="0,2,0,0" />
                        <TextBlock Name="txtPayMsg" FontSize="11.5" Foreground="#2E7D32" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Bank details &amp; application charges are set on the agent bill (collective)."
                                   FontSize="11" Foreground="#999" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#EAF4EA" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Name="txtGrandVehicles" Text="Vehicles: 0" FontWeight="Bold" FontSize="13" />
                        <TextBlock Name="txtGrandRepo" Text="Total Repo: 0" FontSize="12.5" Foreground="#2E7D32" />
                        <TextBlock Name="txtGrandCash" Text="Total Cash Collected: 0" FontSize="12.5" Foreground="#B26A00" />
                        <TextBlock Name="txtGrandFinal" Text="Total Final: 0" FontSize="12.5" Foreground="#1565C0" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Button Grid.Row="3" Name="btnAgentBill" Content="Generate Agent Bill"
                        Height="38" FontWeight="Bold" Margin="0,10,0,0" Cursor="Hand"
                        Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                        Click="btnAgentBill_Click"
                        ToolTip="Click a vehicle row to pick its agent, then generate a combined bill for all that agent's vehicles in the selected dates" />
            </Grid>
        </Border>
    </Grid>
</Page>

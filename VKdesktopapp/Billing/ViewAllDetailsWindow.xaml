<Window x:Class="CRMRSDesktopApp.Billing.ViewAllDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Repo Submissions, All Details" Height="640" Width="1180"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Background="#F5F5F5">
    <Window.Resources>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Vehicles submitted OK-for-Repo from the app (your allocated finances only)"
                   FontSize="15" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,10" />

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="From" VerticalAlignment="Center" Foreground="#666" Margin="0,0,6,0" />
            <DatePicker Name="dpFrom" Width="130" Margin="0,0,14,0" SelectedDateChanged="Filter_Changed" />
            <TextBlock Text="To" VerticalAlignment="Center" Foreground="#666" Margin="0,0,6,0" />
            <DatePicker Name="dpTo" Width="130" Margin="0,0,14,0" SelectedDateChanged="Filter_Changed" />
            <TextBlock Text="Billing" VerticalAlignment="Center" Foreground="#666" Margin="0,0,6,0" />
            <ComboBox Name="cmbAction" Width="150" Margin="0,0,14,0" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="OK for billing" />
                <ComboBoxItem Content="Hold for collection" />
                <ComboBoxItem Content="Collection done" />
                <ComboBoxItem Content="Cancel" />
            </ComboBox>
            <TextBlock Text="Status" VerticalAlignment="Center" Foreground="#666" Margin="0,0,6,0" />
            <ComboBox Name="cmbStatus" Width="120" Margin="0,0,14,0" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="Pending" />
                <ComboBoxItem Content="Billed" />
            </ComboBox>
            <Button Name="btnRefresh" Content="↻ Refresh" Width="100" Height="30" FontWeight="Bold"
                    Background="#1565C0" Foreground="White" BorderThickness="0" Cursor="Hand" Click="btnRefresh_Click" />
            <TextBlock Name="txtStatus" VerticalAlignment="Center" Foreground="#888" FontSize="12" Margin="14,0,0,0" />
        </WrapPanel>

        <DataGrid Grid.Row="2" Name="grid" Style="{StaticResource XlGrid}"
                  IsReadOnly="False" CellEditEnding="grid_CellEditEnding"
                  SelectionUnit="CellOrRowHeader" CanUserSortColumns="False" FrozenColumnCount="2"
                  RowDetailsVisibilityMode="VisibleWhenSelected">
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="#FFFBF4" BorderBrush="#EF6C00" BorderThickness="3,0,0,1" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="FULL RECORD" FontSize="10.5" FontWeight="Bold"
                                       Foreground="#EF6C00" Margin="0,0,0,8" />
                            <WrapPanel>
                                <StackPanel><TextBlock Text="Vehicle No" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding VehicleNo}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Chassis No" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding ChassisNo}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Engine No" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding EngineNo}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Customer" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding CustomerName}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Loan No" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding LoanNo}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Model/Maker" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding Model}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Finance" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding FinanceName}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Branch" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding BranchName}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Agent" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding AgentName}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Parking Yard" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding ParkingYardName}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Yard Mobile" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding ParkingYardMobile}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Executive" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding ExecutiveName}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Status" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding ActionText}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Bill Status" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding BillStatusText}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Repo Date" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding RepoDate}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                                <StackPanel><TextBlock Text="Invoice No" Style="{StaticResource XlDetailLabel}" /><TextBlock Text="{Binding InvoiceNo}" Style="{StaticResource XlDetailValue}" /></StackPanel>
                            </WrapPanel>
                            <TextBlock Text="Load Details" Style="{StaticResource XlDetailLabel}" />
                            <TextBlock Text="{Binding LoadDetails}" Style="{StaticResource XlDetailValue}" />
                            <TextBlock Text="Additional Charges (Notes, Amount)" Style="{StaticResource XlDetailLabel}" />
                            <TextBlock Text="{Binding AddlCharges}" Style="{StaticResource XlDetailValue}" />
                            <TextBlock Text="Confirmation By (Name, Mobile)" Style="{StaticResource XlDetailLabel}" />
                            <TextBlock Text="{Binding ConfirmationBy}" Style="{StaticResource XlDetailValue}" />
                            <TextBlock Text="Collection Update" Style="{StaticResource XlDetailLabel}" />
                            <TextBlock Text="{Binding CollectionUpdate}" Style="{StaticResource XlDetailValue}" />
                            <TextBlock Text="Remark" Style="{StaticResource XlDetailLabel}" />
                            <TextBlock Text="{Binding Remark}" Style="{StaticResource XlDetailValue}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Repo Date" Binding="{Binding CreatedAt}" Width="120" MinWidth="90" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                <DataGridTemplateColumn Header="Vehicle / VIN" Width="130" MinWidth="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding VehicleOrChassis}" Click="btnVehicle_Click" Tag="{Binding Id}"
                                    Cursor="Hand" HorizontalContentAlignment="Left" Margin="8,0" ToolTip="Click to see full vehicle details">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="{TemplateBinding Content}" Foreground="#D32F2F" FontWeight="Bold"
                                                   TextDecorations="Underline" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="160" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                <DataGridTextColumn Header="Finance" Binding="{Binding FinanceName}" Width="140" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                <DataGridTextColumn Header="Branch" Binding="{Binding BranchName}" Width="120" MinWidth="80" ElementStyle="{StaticResource XlText}" />
                <DataGridTextColumn Header="Loan No" Binding="{Binding LoanNo}" Width="120" MinWidth="80" ElementStyle="{StaticResource XlText}" />
                <DataGridTextColumn Header="Agent" Binding="{Binding AgentName}" Width="120" MinWidth="80" ElementStyle="{StaticResource XlText}" />
                <DataGridTextColumn Header="Parking Yard" Binding="{Binding ParkingYardName}" Width="130" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                <DataGridTextColumn Header="Addl Amt" Binding="{Binding AddlChargesAmount}" Width="90" MinWidth="70" ElementStyle="{StaticResource XlText}" />
                <DataGridTextColumn Header="Collection Update" Binding="{Binding CollectionUpdate}" Width="160" MinWidth="100" ElementStyle="{StaticResource XlText}" />
                <DataGridTextColumn Header="Remark" Binding="{Binding Remark}" Width="160" MinWidth="100" ElementStyle="{StaticResource XlText}" />
                <DataGridTextColumn Header="Billing" Binding="{Binding ActionText}" Width="130" MinWidth="90" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90" MinWidth="70" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                <DataGridTemplateColumn Header="Change Billing" Width="120" MinWidth="110" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Change" Height="26" Margin="4,2,4,2" Cursor="Hand"
                                    Click="btnChangeAction_Click" Tag="{Binding Id}"
                                    ToolTip="Set OK for billing, Hold for collection or Cancel" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Action" Width="130" MinWidth="120" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Generate Bill" Height="26" Margin="4,2,4,2" Cursor="Hand"
                                    Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                                    Click="btnGenerate_Click" Tag="{Binding Id}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>

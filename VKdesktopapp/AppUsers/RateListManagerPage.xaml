<Page
    x:Class="CRMRSDesktopApp.AppUsers.RateListManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource Gray50}"
    FontFamily="{StaticResource FontBody}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Rate List" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Gray900}" />
            <TextBlock Text="Publish rate sheets and links. Everything here shows up in the Rate List card in the mobile app, for admins and field agents alike."
                       FontSize="12" Foreground="{StaticResource Gray600}" Margin="0,2,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,16"
                BorderBrush="{StaticResource Gray200}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="rbFile" Content="Attachment" IsChecked="True" GroupName="kind"
                                 FontWeight="SemiBold" Margin="0,0,18,0" Checked="Kind_Changed" />
                    <RadioButton x:Name="rbLink" Content="Link" GroupName="kind"
                                 FontWeight="SemiBold" Checked="Kind_Changed" />
                </StackPanel>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Title" FontSize="11" Foreground="{StaticResource Gray600}" />
                        <TextBox x:Name="txtTitle" Height="32" Margin="0,2,0,0" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Head Office (optional)" FontSize="11" Foreground="{StaticResource Gray600}" />
                        <ComboBox x:Name="cmbFinance" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  Height="32" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="pnlLink" Visibility="Collapsed" Margin="0,0,0,10">
                    <TextBlock Text="URL" FontSize="11" Foreground="{StaticResource Gray600}" />
                    <TextBox x:Name="txtUrl" Height="32" Margin="0,2,0,0" VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Notes (optional)" FontSize="11" Foreground="{StaticResource Gray600}" />
                    <TextBox x:Name="txtNotes" Height="32" Margin="0,2,0,0" VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Visible to these app users" FontSize="11" Foreground="{StaticResource Gray600}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <ToggleButton x:Name="btnUsers" Width="300" Height="32" Content="No users selected"
                                      HorizontalContentAlignment="Left" Padding="8,0" Cursor="Hand"
                                      ToolTip="Tick the agents who should see this entry in the app" />
                        <Popup x:Name="popUsers" PlacementTarget="{Binding ElementName=btnUsers}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True"
                               IsOpen="{Binding IsChecked, ElementName=btnUsers, Mode=TwoWay}">
                            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8">
                                <StackPanel Width="340">
                                    <TextBox x:Name="txtUserSearch" Height="26" Margin="0,0,0,6"
                                             VerticalContentAlignment="Center" Padding="6,0"
                                             ToolTip="Type to narrow the list"
                                             TextChanged="UserSearch_Changed"
                                             KeyDown="UserPicker_KeyDown" />
                                    <ListBox x:Name="lstUserPicks" MaxHeight="300" BorderThickness="0"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                          Margin="2" Click="UserPick_Changed">
                                                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap"
                                                               Foreground="#222222" FontSize="12.5" />
                                                </CheckBox>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Select all" Height="26" Padding="10,0" Margin="0,0,6,0"
                                                Cursor="Hand" Click="btnSelectAllUsers_Click" />
                                        <Button Content="Clear" Height="26" Padding="10,0" Margin="0,0,6,0"
                                                Cursor="Hand" Click="btnClearUsers_Click" />
                                        <Button Content="Done" Height="26" Padding="14,0" Cursor="Hand"
                                                Background="#1565C0" Foreground="White" BorderThickness="0"
                                                Click="btnDoneUsers_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                    <TextBlock Text="An entry with nobody selected stays hidden in the app."
                               FontSize="10.5" Foreground="{StaticResource Gray500}" Margin="0,3,0,0" />
                </StackPanel>

                <DockPanel>
                    <Button x:Name="btnPublish" DockPanel.Dock="Right" Content="Publish" Padding="22,7"
                            Background="#1565C0" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="Publish_Click" />
                    <Button x:Name="btnChoose" DockPanel.Dock="Right" Content="Choose file…" Padding="14,7"
                            Margin="0,0,10,0" Cursor="Hand" Click="ChooseFile_Click" />
                    <TextBlock x:Name="txtChosen" Text="No file chosen" FontSize="11"
                               Foreground="{StaticResource Gray600}" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <TextBlock x:Name="txtEmpty" Text="Nothing published yet." HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{StaticResource Gray600}" Visibility="Collapsed" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="listItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="8" Margin="0,0,0,8" Padding="14"
                                    BorderBrush="{StaticResource Gray200}" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontSize="22"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Users" Tag="{Binding Id}" Click="EditUsers_Click"
                                                Padding="12,6" Margin="0,0,8,0" Cursor="Hand"
                                                ToolTip="Change who can see this entry" />
                                        <Button Content="Open" Tag="{Binding Url}" Click="Open_Click"
                                                Padding="12,6" Margin="0,0,8,0" Cursor="Hand" />
                                        <Button Content="Delete" Tag="{Binding Id}" Click="Delete_Click" Padding="12,6"
                                                Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                   Foreground="{StaticResource Gray900}" FontSize="14" />
                                        <TextBlock Text="{Binding SubtitleDisplay}" FontSize="11"
                                                   Foreground="{StaticResource Gray600}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Notes}" FontSize="11"
                                                   Foreground="{StaticResource Gray500}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding AudienceDisplay}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#B45309" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <SolidColorBrush x:Key="XlHeaderBg"     Color="#EDEFF2" />
    <SolidColorBrush x:Key="XlHeaderFg"     Color="#1F2937" />
    <SolidColorBrush x:Key="XlHeaderLine"   Color="#BFC6CF" />
    <SolidColorBrush x:Key="XlGridLine"     Color="#E2E6EB" />
    <SolidColorBrush x:Key="XlRowBg"        Color="#FFFFFF" />
    <SolidColorBrush x:Key="XlRowAltBg"     Color="#F8F9FB" />
    <SolidColorBrush x:Key="XlHoverBg"      Color="#EAF2FD" />
    <SolidColorBrush x:Key="XlSelectBg"     Color="#FFEBD2" />
    <SolidColorBrush x:Key="XlSelectHover"  Color="#FFE0BA" />
    <SolidColorBrush x:Key="XlSelectBar"    Color="#EF6C00" />
    <SolidColorBrush x:Key="XlText"         Color="#1F2937" />
    <SolidColorBrush x:Key="XlTextStrong"   Color="#111827" />
    <SolidColorBrush x:Key="XlTextMuted"    Color="#6B7280" />
    <SolidColorBrush x:Key="XlPositive"     Color="#1B7F3B" />
    <SolidColorBrush x:Key="XlNegative"     Color="#C62828" />
    <SolidColorBrush x:Key="XlCash"         Color="#B26A00" />

    <Style x:Key="XlHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource XlHeaderBg}" />
        <Setter Property="Foreground" Value="{StaticResource XlHeaderFg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SeparatorBrush" Value="{StaticResource XlHeaderLine}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource XlHeaderLine}"
                                BorderThickness="0,0,1,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6"
                               Cursor="SizeWE" Opacity="0">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#E2E6EC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="XlRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource XlRowBg}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{StaticResource XlRowAltBg}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource XlHoverBg}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource XlSelectBg}" />
                <Setter Property="BorderBrush" Value="{StaticResource XlSelectBar}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource XlSelectHover}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="XlCell" TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource XlText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="cellbd"
                            Background="Transparent"
                            BorderBrush="{StaticResource XlGridLine}"
                            BorderThickness="0,0,1,1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource XlTextStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="cellbd" Property="BorderBrush" Value="{StaticResource XlSelectBar}" />
                            <Setter TargetName="cellbd" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="XlText" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
    </Style>

    <Style x:Key="XlTextBold" TargetType="TextBlock" BasedOn="{StaticResource XlText}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource XlTextStrong}" />
    </Style>

    <Style x:Key="XlNum" TargetType="TextBlock" BasedOn="{StaticResource XlText}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
    </Style>

    <Style x:Key="XlMoney" TargetType="TextBlock" BasedOn="{StaticResource XlNum}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="XlCashCell" TargetType="TextBlock" BasedOn="{StaticResource XlNum}">
        <Setter Property="Foreground" Value="{StaticResource XlCash}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="XlEditCell" TargetType="TextBox">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="#FFFDF5" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
    </Style>

    <Style x:Key="XlGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource XlRowBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource XlHeaderLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="{StaticResource XlRowBg}" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="RowHeight" Value="30" />
        <Setter Property="ColumnHeaderHeight" Value="34" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource XlHeader}" />
        <Setter Property="RowStyle" Value="{StaticResource XlRow}" />
        <Setter Property="CellStyle" Value="{StaticResource XlCell}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="False" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    </Style>

    <Style x:Key="XlDetailLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource XlTextMuted}" />
        <Setter Property="Margin" Value="0,0,0,1" />
    </Style>

    <Style x:Key="XlDetailValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource XlTextStrong}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,18,8" />
    </Style>

</ResourceDictionary>

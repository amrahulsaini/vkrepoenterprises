<Window x:Class="CRMRSDesktopApp.FingerprintLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in" Width="392"
        SizeToContent="Height" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="White">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12"
                    Background="White" BorderBrush="#FFE4E4E7" BorderThickness="1" Padding="4">
                <Image Name="imgAgency" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,0,0">
                <TextBlock Name="lblAgency" Text="CRMRS" FontSize="17" FontWeight="Bold"
                           Foreground="#FF0D0D0F" TextWrapping="Wrap" />
                <TextBlock Name="lblTitle" Text="FINGERPRINT SIGN IN" FontSize="9.5" FontWeight="Bold"
                           Foreground="#FF9A9AA3" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" Name="lblHint" TextWrapping="Wrap" FontSize="12"
                   Foreground="#FF6B6B74" Margin="0,0,0,14"
                   Text="Scan this with the CRMRS app on your phone, then confirm with your fingerprint." />

        <Border Grid.Row="2" Width="196" Height="196" HorizontalAlignment="Center"
                BorderBrush="#FFE4E4E7" BorderThickness="1" CornerRadius="10" Padding="6">
            <Image Name="imgQr" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <TextBlock Text="CODE" FontSize="10" FontWeight="Bold" Foreground="#FF9A9AA3"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <Border Background="#FFFFF4EE" BorderBrush="#FFFFD9C2" BorderThickness="1"
                    CornerRadius="6" Padding="12,4">
                <TextBlock Name="lblPair" Text="--" FontSize="20" FontWeight="Bold"
                           Foreground="#FFCC3C00" />
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="4" Name="lblStatus" TextWrapping="Wrap" TextAlignment="Center"
                   FontSize="12.5" Foreground="#FF6B6B74" Margin="0,14,0,0"
                   Text="Waiting for your phone..." />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Name="btnCancel" Content="Cancel" Width="88" Height="34" Margin="0,0,9,0"
                    Click="btnCancel_Click" />
            <Button Name="btnRetry" Content="New code" Width="104" Height="34" FontWeight="Bold"
                    Background="#FFFF5500" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="btnRetry_Click" />
        </StackPanel>
    </Grid>
</Window>

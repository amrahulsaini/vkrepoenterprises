<Window x:Class="CRMRSDesktopApp.Couriers.CourierRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Full Record" Height="700" Width="920"
        WindowStartupLocation="CenterOwner" Background="#F5F5F5"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="TblHead" TargetType="Border">
            <Setter Property="Background" Value="#FBF1E2" />
            <Setter Property="BorderBrush" Value="#E4D8C6" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="9,7" />
        </Style>
        <Style x:Key="TblBody" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4D8C6" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="9,7" />
        </Style>
        <Style x:Key="TblLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8A6D3B" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TblValue" TargetType="TextBox">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Close" Width="90" Height="32" Cursor="Hand"
                    Click="Close_Click" />
            <Button DockPanel.Dock="Right" Content="Copy all" Width="90" Height="32" Margin="0,0,8,0"
                    Cursor="Hand" Click="CopyAll_Click"
                    ToolTip="Copy the whole record as label/value rows, ready to paste into Excel" />
            <StackPanel>
                <TextBlock Name="txtHeadline" FontSize="17" FontWeight="Bold" Foreground="#EF6C00" />
                <TextBlock Name="txtSubline" FontSize="12" Foreground="#777" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" FontSize="11" Foreground="#999" Margin="0,10,0,0"
                   Text="Values are selectable — drag to highlight and press Ctrl+C, or use Copy all." />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border BorderBrush="#E4D8C6" BorderThickness="1,1,0,0">
                <Grid Name="gridFields">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>

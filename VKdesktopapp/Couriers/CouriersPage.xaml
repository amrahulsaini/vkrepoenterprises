<Page x:Class="CRMRSDesktopApp.Couriers.CouriersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F5">
    <Page.Resources>
        <Style x:Key="Fld" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="TblHead" TargetType="Border">
            <Setter Property="Background" Value="#FBF1E2" />
            <Setter Property="BorderBrush" Value="#E4D8C6" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="9,6" />
        </Style>
        <Style x:Key="TblBody" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4D8C6" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="9,6" />
        </Style>
        <Style x:Key="TblLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8A6D3B" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TblValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Margin="14">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Courier Department" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource Accent}" Margin="0,0,0,8" />

            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="#666" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Margin" Value="0,0,6,0" />
                    </Style>
                    <Style TargetType="DatePicker">
                        <Setter Property="Height" Value="28" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Height" Value="28" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                    <Style TargetType="Button">
                        <Setter Property="Height" Value="28" />
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Height" Value="28" />
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>
                </StackPanel.Resources>

                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                    <TextBlock Text="From" />
                    <DatePicker Name="dpFrom" Width="120" SelectedDateChanged="Filter_Changed" />
                    <TextBlock Text="To" Margin="12,0,6,0" />
                    <DatePicker Name="dpTo" Width="120" SelectedDateChanged="Filter_Changed" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                    <TextBlock Text="Billing Status" />
                    <ToggleButton Name="btnStatuses" Width="190" Content="All statuses"
                                  HorizontalContentAlignment="Left" Padding="8,0"
                                  ToolTip="Tick one or more billing statuses to show only those records" />
                    <Popup Name="popStatuses" PlacementTarget="{Binding ElementName=btnStatuses}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True"
                           IsOpen="{Binding IsChecked, ElementName=btnStatuses, Mode=TwoWay}">
                        <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8">
                            <StackPanel Width="230">
                                <ItemsControl Name="lstStatusPicks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Margin="2,3" Click="StatusPick_Changed">
                                                <TextBlock Text="{Binding Name}" Foreground="#222222" FontSize="12.5" />
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Clear selection" Height="26" Margin="0,6,0,0"
                                        Cursor="Hand" Click="btnClearStatus_Click" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Name="btnClearStatusTop" Content="✕" Width="28" Margin="4,0,0,0"
                            ToolTip="Clear billing status filter" Click="btnClearStatus_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                    <TextBlock Text="Finance" />
                    <ComboBox Name="cmbFinance" Width="190" IsEditable="True" IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True"
                              SelectionChanged="Finance_Changed" KeyUp="Finance_Key"
                              ToolTip="Type to search a finance / head office, or pick from the list" />
                    <Button Name="btnClearFinance" Content="✕" Width="28" Margin="4,0,0,0"
                            ToolTip="Clear finance filter" Click="btnClearFinance_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                    <TextBlock Text="Agent" />
                    <ToggleButton Name="btnAgents" Width="190" Content="All agents"
                                  HorizontalContentAlignment="Left" Padding="8,0"
                                  ToolTip="Tick one or more agents to show only their records" />
                <Popup Name="popAgents" PlacementTarget="{Binding ElementName=btnAgents}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True"
                       IsOpen="{Binding IsChecked, ElementName=btnAgents, Mode=TwoWay}">
                    <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8">
                        <StackPanel Width="380">
                            <TextBox Name="txtAgentSearch" Height="26" Margin="0,0,0,6"
                                     VerticalContentAlignment="Center" Padding="6,0"
                                     ToolTip="Type to narrow the list, then press Enter to apply"
                                     TextChanged="AgentSearch_Changed" KeyDown="AgentPicker_KeyDown" />
                            <ListBox Name="lstAgentPicks" MaxHeight="340" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Margin="2" Click="AgentPick_Changed">
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="#222222" FontSize="12.5" Margin="0" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Clear selection" Height="26" Padding="10,0" Margin="0,0,6,0"
                                        Cursor="Hand" Click="btnClearAgent_Click" />
                                <Button Content="Apply" Height="26" Padding="16,0" Cursor="Hand"
                                        Background="#1565C0" Foreground="White" BorderThickness="0"
                                        Click="btnApplyAgents_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
                    <Button Name="btnClearAgentTop" Content="✕" Width="28" Margin="4,0,0,0"
                            ToolTip="Clear agent filter" Click="btnClearAgent_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                    <TextBlock Text="RC last 4" />
                    <TextBox Name="txtRcLast4" Width="90" Height="28" MaxLength="6"
                             VerticalContentAlignment="Center" TextAlignment="Center" FontWeight="Bold"
                             ToolTip="Type the last 4 digits of the RC or chassis"
                             TextChanged="RcLast4_Changed" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <Button Name="btnRefresh" Content="↻ Refresh" Width="100" FontWeight="Bold"
                            Background="#1565C0" Foreground="White" BorderThickness="0"
                            ToolTip="Reload records from the server" Click="btnRefresh_Click" />
                    <TextBlock Name="txtStatus" Foreground="#888" Margin="14,0,0,0" />
                </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <DataGrid Name="grid" AutoGenerateColumns="False" IsReadOnly="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      Style="{StaticResource XlGrid}" CanUserSortColumns="True" FrozenColumnCount="2"
                      RowDetailsVisibilityMode="Collapsed"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      ClipboardCopyMode="IncludeHeader"
                      PreviewMouseLeftButtonDown="Grid_CellClick"
                      PreviewKeyDown="Grid_PreviewKeyDown"
                      PreviewMouseRightButtonDown="Grid_PreviewRightClick"
                      CellEditEnding="grid_CellEditEnding">
                <DataGrid.Resources>
                    <Style x:Key="PickEdit" TargetType="ComboBox">
                        <Setter Property="IsDropDownOpen" Value="True" />
                        <EventSetter Event="SelectionChanged" Handler="Pick_Changed" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy cell"                       Click="CopyCell_Click" />
                        <MenuItem Header="Copy selected rows"              Click="CopySelection_Click"    InputGestureText="Ctrl+C" />
                        <MenuItem Header="Copy selected rows + headers"    Click="CopySelectionHdr_Click" InputGestureText="Ctrl+Shift+C" />
                        <Separator />
                        <MenuItem Header="Copy this column"                Click="CopyColumn_Click" />
                        <MenuItem Header="Copy this column for selection"  Click="CopyColumnSel_Click" />
                        <Separator />
                        <MenuItem Header="Copy whole table"         Click="CopyTable_Click" />
                        <Separator />
                        <MenuItem Header="Download bill…"           Click="DownloadBill_Click" />
                        <MenuItem Header="Open payment screenshots" Click="OpenScreenshots_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridComboBoxColumn x:Name="colBilling" Header="Billing" SortMemberPath="ActionText"
                                            SelectedValueBinding="{Binding ActionKey, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Key" DisplayMemberPath="Name"
                                            EditingElementStyle="{StaticResource PickEdit}" Width="150" MinWidth="100" />
                    <DataGridComboBoxColumn x:Name="colInventory" Header="Inventory" SortMemberPath="CourierYn"
                                            SelectedItemBinding="{Binding CourierYn, UpdateSourceTrigger=PropertyChanged}"
                                            EditingElementStyle="{StaticResource PickEdit}" Width="85" MinWidth="60" />
                    <DataGridTextColumn Header="Inventory Remark" Binding="{Binding InventoryRemark, UpdateSourceTrigger=Explicit}" Width="180" MinWidth="100" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Billing Remark" Binding="{Binding BillingRemark, UpdateSourceTrigger=Explicit}" Width="180" MinWidth="100" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Repo Date" Binding="{Binding RepoDate, UpdateSourceTrigger=Explicit}" Width="120" MinWidth="90" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Loan No" Binding="{Binding LoanNo, UpdateSourceTrigger=Explicit}" Width="150" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Invoice No" Binding="{Binding InvoiceNo, UpdateSourceTrigger=Explicit}" Width="90" MinWidth="70" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName, UpdateSourceTrigger=Explicit}" Width="150" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Finance" Binding="{Binding FinanceName, UpdateSourceTrigger=Explicit}" Width="130" MinWidth="80" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Branch" Binding="{Binding BranchName, UpdateSourceTrigger=Explicit}" Width="120" MinWidth="80" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Vehicle No" Binding="{Binding VehicleNo, UpdateSourceTrigger=Explicit}" Width="110" MinWidth="80" IsReadOnly="True" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Model/Maker" Binding="{Binding Model, UpdateSourceTrigger=Explicit}" Width="160" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Chassis No" Binding="{Binding ChassisNo, UpdateSourceTrigger=Explicit}" Width="150" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Engine No" Binding="{Binding EngineNo, UpdateSourceTrigger=Explicit}" Width="140" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Agent Name" Binding="{Binding AgentName, UpdateSourceTrigger=Explicit}" Width="130" MinWidth="80" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Parking Yard Name" Binding="{Binding ParkingYardName, UpdateSourceTrigger=Explicit}" Width="160" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Parking Yard Mobile" Binding="{Binding ParkingYardMobile, UpdateSourceTrigger=Explicit}" Width="130" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Load Details" Binding="{Binding LoadDetails, UpdateSourceTrigger=Explicit}" Width="120" MinWidth="80" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Additional Charges Notes, Amount" Binding="{Binding AddlCharges, UpdateSourceTrigger=Explicit}" Width="200" MinWidth="110" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Confirmation By (Name, Mobile)" Binding="{Binding ConfirmationBy, UpdateSourceTrigger=Explicit}" Width="190" MinWidth="110" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Executive Name" Binding="{Binding ExecutiveName, UpdateSourceTrigger=Explicit}" Width="130" MinWidth="80" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Collection Update" Binding="{Binding CollectionUpdate, UpdateSourceTrigger=Explicit}" Width="150" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Banker Address" Binding="{Binding BankerAddress, UpdateSourceTrigger=Explicit}" Width="150" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="POD Number" Binding="{Binding PodNumber, UpdateSourceTrigger=Explicit}" Width="110" MinWidth="70" ElementStyle="{StaticResource XlText}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Page>

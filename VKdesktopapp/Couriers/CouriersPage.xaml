<Page x:Class="CRMRSDesktopApp.Couriers.CouriersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F5">
    <Page.Resources>
        <Style x:Key="Fld" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="TblHead" TargetType="Border">
            <Setter Property="Background" Value="#FBF1E2" />
            <Setter Property="BorderBrush" Value="#E4D8C6" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="9,6" />
        </Style>
        <Style x:Key="TblBody" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4D8C6" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="9,6" />
        </Style>
        <Style x:Key="TblLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8A6D3B" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TblValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,14,0">
            <TextBlock DockPanel.Dock="Top" Text="Courier Department" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource Accent}" Margin="0,0,0,8" />

            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <WrapPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="#666" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Margin" Value="0,0,6,0" />
                    </Style>
                    <Style TargetType="DatePicker">
                        <Setter Property="Height" Value="28" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Height" Value="28" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                    <Style TargetType="Button">
                        <Setter Property="Height" Value="28" />
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Height" Value="28" />
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>
                </WrapPanel.Resources>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                    <TextBlock Text="From" />
                    <DatePicker Name="dpFrom" Width="120" SelectedDateChanged="Filter_Changed" />
                    <TextBlock Text="To" Margin="12,0,6,0" />
                    <DatePicker Name="dpTo" Width="120" SelectedDateChanged="Filter_Changed" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                    <TextBlock Text="Billing Status" />
                    <ToggleButton Name="btnStatuses" Width="190" Content="All statuses"
                                  HorizontalContentAlignment="Left" Padding="8,0"
                                  ToolTip="Tick one or more billing statuses to show only those records" />
                    <Popup Name="popStatuses" PlacementTarget="{Binding ElementName=btnStatuses}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True"
                           IsOpen="{Binding IsChecked, ElementName=btnStatuses, Mode=TwoWay}">
                        <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8">
                            <StackPanel Width="230">
                                <ItemsControl Name="lstStatusPicks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Margin="2,3" Click="StatusPick_Changed">
                                                <TextBlock Text="{Binding Name}" Foreground="#222222" FontSize="12.5" />
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Clear selection" Height="26" Margin="0,6,0,0"
                                        Cursor="Hand" Click="btnClearStatus_Click" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Name="btnClearStatusTop" Content="✕" Width="28" Margin="4,0,0,0"
                            ToolTip="Clear billing status filter" Click="btnClearStatus_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                    <TextBlock Text="Finance" />
                    <ComboBox Name="cmbFinance" Width="190" IsEditable="True" IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True"
                              SelectionChanged="Finance_Changed" KeyUp="Finance_Key"
                              ToolTip="Type to search a finance / head office, or pick from the list" />
                    <Button Name="btnClearFinance" Content="✕" Width="28" Margin="4,0,0,0"
                            ToolTip="Clear finance filter" Click="btnClearFinance_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                    <TextBlock Text="Agent" />
                    <ToggleButton Name="btnAgents" Width="190" Content="All agents"
                                  HorizontalContentAlignment="Left" Padding="8,0"
                                  ToolTip="Tick one or more agents to show only their records" />
                <Popup Name="popAgents" PlacementTarget="{Binding ElementName=btnAgents}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True"
                       IsOpen="{Binding IsChecked, ElementName=btnAgents, Mode=TwoWay}">
                    <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8">
                        <StackPanel Width="380">
                            <TextBox Name="txtAgentSearch" Height="26" Margin="0,0,0,6"
                                     VerticalContentAlignment="Center" Padding="6,0"
                                     ToolTip="Type to narrow the list, then press Enter to apply"
                                     TextChanged="AgentSearch_Changed" KeyDown="AgentPicker_KeyDown" />
                            <ListBox Name="lstAgentPicks" MaxHeight="340" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Margin="2" Click="AgentPick_Changed">
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="#222222" FontSize="12.5" Margin="0" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Clear selection" Height="26" Padding="10,0" Margin="0,0,6,0"
                                        Cursor="Hand" Click="btnClearAgent_Click" />
                                <Button Content="Apply" Height="26" Padding="16,0" Cursor="Hand"
                                        Background="#1565C0" Foreground="White" BorderThickness="0"
                                        Click="btnApplyAgents_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
                    <Button Name="btnClearAgentTop" Content="✕" Width="28" Margin="4,0,0,0"
                            ToolTip="Clear agent filter" Click="btnClearAgent_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                    <TextBlock Text="RC last 4" />
                    <TextBox Name="txtRcLast4" Width="90" Height="28" MaxLength="6"
                             VerticalContentAlignment="Center" TextAlignment="Center" FontWeight="Bold"
                             ToolTip="Type the last 4 digits of the RC or chassis"
                             TextChanged="RcLast4_Changed" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Name="btnRefresh" Content="↻ Refresh" Width="100" FontWeight="Bold"
                            Background="#1565C0" Foreground="White" BorderThickness="0"
                            ToolTip="Reload records from the server" Click="btnRefresh_Click" />
                    <TextBlock Name="txtStatus" Foreground="#888" Margin="14,0,0,0" />
                </StackPanel>
            </WrapPanel>

            <DataGrid Name="grid" AutoGenerateColumns="False" IsReadOnly="True"
                      Style="{StaticResource XlGrid}" CanUserSortColumns="True" FrozenColumnCount="2"
                      RowDetailsVisibilityMode="Collapsed"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      ClipboardCopyMode="IncludeHeader"
                      MouseDoubleClick="Grid_MouseDoubleClick"
                      PreviewMouseLeftButtonUp="Grid_RowLeftClick"
                      PreviewKeyDown="Grid_PreviewKeyDown"
                      PreviewMouseRightButtonDown="Grid_PreviewRightClick"
                      SelectionChanged="grid_SelectionChanged">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy cell"                       Click="CopyCell_Click" />
                        <MenuItem Header="Copy selected rows"              Click="CopySelection_Click"    InputGestureText="Ctrl+C" />
                        <MenuItem Header="Copy selected rows + headers"    Click="CopySelectionHdr_Click" InputGestureText="Ctrl+Shift+C" />
                        <Separator />
                        <MenuItem Header="Copy this column"                Click="CopyColumn_Click" />
                        <MenuItem Header="Copy this column for selection"  Click="CopyColumnSel_Click" />
                        <Separator />
                        <MenuItem Header="Copy whole table"         Click="CopyTable_Click" />
                        <Separator />
                        <MenuItem Header="Open full record…"        Click="OpenRecord_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Billing" Binding="{Binding ActionText}" Width="130" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Inventory" Binding="{Binding CourierYn}" Width="85" MinWidth="60" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Inventory Remark" Binding="{Binding InventoryRemark}" Width="180" MinWidth="100" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Repo Date" Binding="{Binding RepoDate}" Width="120" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Loan No" Binding="{Binding LoanNo}" Width="150" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Invoice No" Binding="{Binding InvoiceNo}" Width="90" MinWidth="70" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="150" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Finance" Binding="{Binding FinanceName}" Width="130" MinWidth="80" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Branch" Binding="{Binding BranchName}" Width="120" MinWidth="80" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Vehicle No" Binding="{Binding VehicleNo}" Width="110" MinWidth="80" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Model/Maker" Binding="{Binding Model}" Width="160" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Chassis No" Binding="{Binding ChassisNo}" Width="150" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Engine No" Binding="{Binding EngineNo}" Width="140" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Agent Name" Binding="{Binding AgentName}" Width="130" MinWidth="80" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Parking Yard Name" Binding="{Binding ParkingYardName}" Width="160" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Parking Yard Mobile" Binding="{Binding ParkingYardMobile}" Width="130" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Load Details" Binding="{Binding LoadDetails}" Width="120" MinWidth="80" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Additional Charges Notes, Amount" Binding="{Binding AddlCharges}" Width="200" MinWidth="110" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Confirmation By (Name, Mobile)" Binding="{Binding ConfirmationBy}" Width="190" MinWidth="110" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Executive Name" Binding="{Binding ExecutiveName}" Width="130" MinWidth="80" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Collection Update" Binding="{Binding CollectionUpdate}" Width="150" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="Repo Charges" Binding="{Binding RepoChargesText}" Width="100" MinWidth="70" ElementStyle="{StaticResource XlMoney}" />
                    <DataGridTextColumn Header="Advance" Binding="{Binding AdvanceText}" Width="90" MinWidth="70" ElementStyle="{StaticResource XlMoney}" />
                    <DataGridTextColumn Header="Banker Address" Binding="{Binding BankerAddress}" Width="150" MinWidth="90" ElementStyle="{StaticResource XlText}" />
                    <DataGridTextColumn Header="POD Number" Binding="{Binding PodNumber}" Width="110" MinWidth="70" ElementStyle="{StaticResource XlText}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Update Courier Details" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource Accent}" Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top" Name="txtSel" Text="Select a record from the list."
                           FontSize="12" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,8" />

                <Button DockPanel.Dock="Top" Name="btnDetails" Content="View all details" Height="30" IsEnabled="False"
                        Margin="0,0,0,10" Cursor="Hand" Click="btnDetails_Click" />

                <Border DockPanel.Dock="Top" Name="pnlBilled" Background="#EAF4EA" CornerRadius="6" Padding="10,8"
                        Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Name="txtInvoice" Text="" FontSize="12.5" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,6" />
                        <Button Name="btnDownloadBill" Content="Download bill" Height="28" Padding="10,0"
                                HorizontalAlignment="Left" Background="#1565C0" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="btnDownloadBill_Click" />
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Name="txtFormStatus" Foreground="#2E7D32" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button Name="btnSubmit" Content="Submit" Height="40" FontWeight="Bold" IsEnabled="False"
                            Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="btnSubmit_Click" />
                    <Button Name="btnClear" Content="Clear this record's entries" Height="32" Margin="0,8,0,0" IsEnabled="False"
                            Background="White" Foreground="#C62828" BorderBrush="#E0A0A0" BorderThickness="1"
                            Cursor="Hand" Click="btnClear_Click" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="pnlForm" IsEnabled="False">
                        <TextBlock Text="Billing Status" Foreground="#666" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Name="txtBillingStatus" Style="{StaticResource Fld}" IsReadOnly="True"
                                 Background="#F5F5F5" />

                        <TextBlock Text="Remark (from Ok for Repo)" Foreground="#666" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Name="txtRemark" IsReadOnly="True" Background="#F5F5F5" Height="52"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" Padding="8,4" Margin="0,0,0,10" />

                        <TextBlock Name="lblAddlCharges" Text="Additional Charges (from app)" Foreground="#666" FontSize="12" Margin="0,0,0,3" Visibility="Collapsed" />
                        <TextBox Name="txtAddlChargesInfo" IsReadOnly="True" Background="#F5F5F5" Height="46"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" Padding="8,4" Margin="0,0,0,10" Visibility="Collapsed" />

                        <TextBlock Name="lblCollectionUpdate" Text="Collection Update (from app)" Foreground="#666" FontSize="12" Margin="0,0,0,3" Visibility="Collapsed" />
                        <TextBox Name="txtCollectionUpdate" IsReadOnly="True" Background="#F5F5F5" Height="52"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" Padding="8,4" Margin="0,0,0,10" Visibility="Collapsed" />

                        <Border Name="pnlCash" Background="#FFF6E5" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Total Cash Paid by Customer" Foreground="#8A6D00" FontSize="12" />
                                <TextBlock Name="txtCashPaid" Text="0" FontSize="18" FontWeight="Bold" Foreground="#B26A00" />
                                <TextBlock Name="txtCashNote" Text="" FontSize="11" Foreground="#8A6D00" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Name="lblGross" Text="Total Gross (from billing)" Foreground="#666" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Name="txtGross" Style="{StaticResource Fld}" IsReadOnly="True" Background="#F5F5F5" />

                        <TextBlock Name="lblPercent" Text="Percentage (%) of gross" Foreground="#666" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Name="txtPercent" Style="{StaticResource Fld}" TextChanged="Calc_Changed" />

                        <TextBlock Text="Repo Charges" Foreground="#666" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Name="txtRepoCharges" Style="{StaticResource Fld}" TextChanged="Calc_Changed" />

                        <TextBlock Text="Advance" Foreground="#666" FontSize="12" Margin="0,0,0,3" />
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Name="txtNoAdvances" Text="No advance paid yet." FontSize="11.5"
                                           Foreground="#999" Margin="0,0,0,4" />
                                <ItemsControl Name="lstAdvances">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DateText}" FontSize="12"
                                                           Foreground="#666" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="26" VerticalContentAlignment="Center" Padding="6,0"
                                                         TextChanged="Advance_Edited" />
                                                <Button Grid.Column="2" Content="✕" Width="24" Height="24" Margin="4,0,0,0"
                                                        Cursor="Hand" ToolTip="Remove this advance"
                                                        Click="btnRemoveAdvance_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Name="pnlAddAdvance" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" Name="dpAdvDate" Height="26" Padding="0" />
                                    <TextBox Grid.Column="1" Name="txtAdvAmount" Height="26" Margin="4,0,0,0"
                                             VerticalContentAlignment="Center" Padding="6,0"
                                             ToolTip="Amount of the new advance" KeyUp="AdvAmount_Key" />
                                    <Button Grid.Column="2" Name="btnAddAdvance" Content="+ Add" Height="26" Margin="4,0,0,0"
                                            Padding="8,0" Cursor="Hand" Background="#1565C0" Foreground="White"
                                            BorderThickness="0" Click="btnAddAdvance_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Total Advance" Foreground="#666" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Name="txtAdvance" Style="{StaticResource Fld}" IsReadOnly="True" Background="#F5F5F5" />

                        <TextBlock Text="Final Amount (Repo Charges − Advance)" Foreground="#666" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Name="txtFinal" Style="{StaticResource Fld}" IsReadOnly="True" Background="#F5F5F5" FontWeight="Bold" />

                        <TextBlock Text="Agent Name" Foreground="#666" FontSize="12" Margin="0,0,0,3" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Name="cmbEditAgent" Height="32" IsEditable="True"
                                      IsTextSearchEnabled="True" StaysOpenOnEdit="True" VerticalContentAlignment="Center"
                                      IsEnabled="False"
                                      ToolTip="Pick the agent from the list, or type a correction" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                                <Button Name="btnAgentEdit" Content="&#x270E;" Width="30" Height="32" FontSize="15"
                                        Cursor="Hand" ToolTip="Edit the agent name" Click="btnAgentEdit_Click" />
                                <Button Name="btnAgentSave" Content="&#x2714;" Width="30" Height="32" FontSize="13"
                                        Background="#2E7D32" Foreground="White" BorderThickness="0"
                                        Cursor="Hand" Visibility="Collapsed"
                                        ToolTip="Save the agent name" Click="btnAgentSave_Click" />
                                <Button Name="btnAgentCancel" Content="&#x2715;" Width="30" Height="32" FontSize="13"
                                        Margin="4,0,0,0" Cursor="Hand" Visibility="Collapsed"
                                        ToolTip="Cancel" Click="btnAgentCancel_Click" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Inventory" Foreground="#666" FontSize="12" Margin="0,0,0,3" />
                        <ComboBox Name="cmbCourier" Height="32" Margin="0,0,0,10" SelectedIndex="0">
                            <ComboBoxItem Content="No" />
                            <ComboBoxItem Content="Yes" />
                        </ComboBox>

                        <TextBlock Text="Inventory Remark" Foreground="#666" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Name="txtInventoryRemark" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" Padding="8,4" Margin="0,0,0,6"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="Notes about the inventory handover — saved on its own" />
                        <DockPanel Margin="0,0,0,12">
                            <Button Name="btnSaveInventoryRemark" DockPanel.Dock="Right" Content="Save remark"
                                    Height="28" Padding="14,0" Cursor="Hand"
                                    Background="#2E7D32" Foreground="White" BorderThickness="0"
                                    Click="btnSaveInventoryRemark_Click" />
                            <TextBlock Name="txtInvRemarkStatus" FontSize="11" Foreground="#2E7D32"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>

                        <TextBlock Text="Banker Address" Foreground="#666" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Name="txtBankerAddress" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" Padding="8,4" Margin="0,0,0,10"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="POD Number" Foreground="#666" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Name="txtPod" Style="{StaticResource Fld}" />

                        <TextBlock Name="lblScreenshot" Text="Payment Screenshot" Foreground="#666" FontSize="12" Margin="0,8,0,3" Visibility="Collapsed" />
                        <Border Name="pnlScreenshot" Visibility="Collapsed" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,10">
                            <Image Name="imgScreenshot" MaxHeight="180" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="imgScreenshot_Click" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Page>
